<link rel="stylesheet" href="/stylesheets/style.css">
<link rel="stylesheet" href="/stylesheets/buyassembledkits.css">

<%- include('partials/header') %>

<main class="page-main-with-hero our-work-main buy-kits-main">
    <section class="page-hero-top our-work-hero buy-kits-hero" aria-label="Buy assembled kits hero image">
        <img src="/images/2022/10/DSC09131-scaled.jpg" alt="Boxes of clean birth kits ready for dispatch">
    </section>

    <div class="page-body-with-sidebar">
        <%- include('partials/ourWorkSideMenu') %>

        <div class="page-content our-work-content buy-kits-content">
            <section class="history-text-section">
                

                <h1>BUY KITS</h1>

            <p>
                Clean Birth Kits can be purchased and shipped to your organisation.
            </p>

            <p>
                A minimum order of 200 kits applies at a cost of AU$7 each for kits shipped within Australia, and US$7 each for kits shipped internationally.
            </p>

            <p>
                Our kits are environmentally friendly – the plastic components of our kits have been treated with an organic compound and are biodegradable.
            </p>

            <p>
                Please complete the order form below to purchase your kits
                <strong>
                    for shipping to Australian destinations.
                </strong>
            </p>

            <p>
                If you require kits shipped to a destination outside of Australia, please contact us via email.
            </p>

            </section>

            <section class="map-form-section">
                <div class="map-form-card">
                    <h2>BUY ASSEMBLED KITS</h2>

        <form
            method="POST"
            action="/cleanbirthkits/buyassembledkits"
            class="buy-kits-form"
        >

            <div class="form-grid">

                <!-- FIRST NAME -->
                <div class="form-group form-group--half">

                    <label for="firstName">
                        First Name
                    </label>

                    <input
                        type="text"
                        id="firstName"
                        name="firstName"
                        placeholder="Enter your first name"
                        required
                    >

                </div>

                <!-- LAST NAME -->
                <div class="form-group form-group--half">

                    <label for="lastName">
                        Last Name
                    </label>

                    <input
                        type="text"
                        id="lastName"
                        name="lastName"
                        placeholder="Enter your last name"
                        required
                    >

                </div>

                <!-- EMAIL -->
                <div class="form-group form-group--full">

                    <label for="email">
                        Email
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="Enter your email here"
                        required
                    >

                </div>

                <!-- ADDRESS -->
                <div class="form-divider form-group--full">
                    <span>Address Details</span>
                </div>

                <!-- STREET -->
                <div class="form-group form-group--full">

                    <label for="streetAddress">
                        Street Address
                    </label>

                    <input
                        type="text"
                        id="streetAddress"
                        name="streetAddress"
                        placeholder="Enter your street address"
                    >

                </div>

                <!-- CITY -->
                <div class="form-group form-group--half">

                    <label for="city">
                        City
                    </label>

                    <input
                        type="text"
                        id="city"
                        name="city"
                        placeholder="Enter your city"
                    >

                </div>

                <!-- STATE -->
                <div class="form-group form-group--half">

                    <label for="state">
                        State / Province / Region
                    </label>

                    <input
                        type="text"
                        id="state"
                        name="state"
                        placeholder="Enter your state / province / region"
                    >

                </div>

                <!-- ZIP -->
                <div class="form-group form-group--half">

                    <label for="zipPostal">
                        ZIP / Postal Code
                    </label>

                    <input
                        type="text"
                        id="zipPostal"
                        name="zipPostal"
                        placeholder="Enter your ZIP / Postal Code"
                    >

                </div>

                <!-- COUNTRY -->
                <div class="form-group form-group--half">

                    <label for="country">
                        Country
                    </label>

                    <select
                        id="country"
                        name="country"
                    >

                        <option value="" disabled selected>
                            Select a country
                        </option>

                        <option value="AU">
                            Australia
                        </option>

                        <option value="NZ">
                            New Zealand
                        </option>

                        <option value="US">
                            United States
                        </option>

                        <option value="GB">
                            United Kingdom
                        </option>

                        <option value="CA">
                            Canada
                        </option>

                        <option value="other">
                            Other
                        </option>

                    </select>

                </div>

                <!-- ORDER DETAILS -->
                <div class="form-divider form-group--full">
                    <span>Order Details</span>
                </div>

                <div class="form-group form-group--full">

                    <div class="kit-price-display">
                        Price:
                        <span>$7.00</span>
                        per kit
                    </div>

                </div>

                <!-- NUM KITS -->
                <div class="form-group form-group--half">

                    <label for="numKits">
                        Number of Kits
                    </label>

                    <input
                        type="number"
                        id="numKits"
                        name="numKits"
                        min="200"
                        max="1000"
                        placeholder="Enter quantity"
                        oninput="updateTotal()"
                        required
                    >

                    <span class="form-helper-text">
                        Minimum kit order, 200.
                    </span>

                </div>

                <!-- TOTAL -->
                <div class="form-group form-group--half">

                    <label>
                        Total Price
                    </label>

                    <div
                        class="kit-total-display"
                        id="kitTotal"
                    >
                        —
                    </div>

                </div>

                <!-- TERMS -->
                <div class="form-group form-group--full">

                    <div class="form-checkboxes">

                        <label class="checkbox-label">

                            <input
                                type="checkbox"
                                id="acceptTerms"
                                name="acceptTerms"
                                required
                            >

                            <span>
                                I acknowledge that the Birthing Kit Foundation (Australia) takes no responsibility for the in-country processes associated with the clearance and collection of Clean Birth Kits, including: customs, taxes, handling charges and any other fees. Dollar amounts are in AUD.
                            </span>

                        </label>

                    </div>

                </div>

                <!-- PAYMENT NOTICE -->
                <div class="form-divider form-group--full">
                    <span>Payment Information</span>
                </div>

                <div class="form-group form-group--full">

                    <p style="
                        background: #f4f4f4;
                        padding: 1rem;
                        border-left: 4px solid #555583;
                        border-radius: 8px;
                        line-height: 1.6;
                    ">
                        Payment is not processed through this form.
                        Once your order request has been reviewed,
                        BKFA will contact you regarding payment and shipping arrangements.
                    </p> <!-- THIS IS A PLACEHOLDER FOR PAYMENT INFO, TO BE REPLACED WITH ACTUAL PAYMENT INTEGRATION IN THE FUTURE -->

                </div>

            </div>


            <div class="captcha-wrapper">
                <div
                class="g-recaptcha"
                data-sitekey="<%= process.env.RECAPTCHA_SITE_KEY %>">
                </div>
            </div>

            <button
                class="form-submit-btn"
                type="submit"
            >
                Submit Order
            </button>

        </form>

                </div>
            </section>
        </div>
    </div>
</main>

<script src="https://www.google.com/recaptcha/api.js" async defer></script>

<script>

    function updateTotal() {

        const qty =
            parseInt(
                document.getElementById(
                    'numKits'
                ).value
            ) || 0;

        const totalEl =
            document.getElementById(
                'kitTotal'
            );

        if (qty > 0) {

            totalEl.textContent =
                '$' + (qty * 7).toFixed(2);

        } else {

            totalEl.textContent = '—';

        }
    }

    const buyKitsForm =
        document.querySelector('.buy-kits-form');

    buyKitsForm.addEventListener(
        'submit',
        function (e) {

            const captchaResponse =
                grecaptcha.getResponse();

            if (!captchaResponse) {

                e.preventDefault();

                alert(
                    'Please complete the CAPTCHA before submitting the form.'
                );
            }
        }
    );


</script>

<%- include('partials/footer') %>
