<script>

    // Script that does a variety of important features on this page.
    // This includes a carousel to show details of each staff member,
    // as well as clickable above to immediately go to member on the carousel.
    document.addEventListener('DOMContentLoaded', () => {

        // variable that targets all staff section containers on page
        // with the structure above, this allows seperate carousels for each section
        const staffSections = document.querySelectorAll('.staff-section');

        // loop through staff sections
        staffSections.forEach(section => {

            // set up variables with classes
            // grabs all items inside the carousel to know calculate number
            const slides = section.querySelectorAll('.carousel-item');
            //
            const track = section.querySelector('.carousel-track');
            const prevBtn = section.querySelector('.prev-btn');
            const nextBtn = section.querySelector('.next-btn');
            const gridMembers = section.querySelectorAll('.team-grid .team-member');
            const carouselContainer = section.querySelector('.team-carousel-container');

            // index for staff members
            let currentIndex = 0

            // function to move through carousel
            function updateCarousel(newIndex) {
                // if index goes below 0, go to last entry
                if (newIndex < 0) {
                    currentIndex = slides.length - 1;
                // if index is greater than or equel to length, go to first entry
                } else if (newIndex >= slides.length) {
                    currentIndex = 0;
                // change current position on carousel to indicated index
                } else {
                    currentIndex = newIndex;
                }
                // slide only by the same amount (total length of the member slide)
                track.style.transform = `translateX(-${currentIndex * 100}%)`;
            }

            // section button arrow event listeners
            // makes index go back by one
            prevBtn.addEventListener('click', () => {
                updateCarousel(currentIndex - 1);
            });

            // makes index go forward by one
            nextBtn.addEventListener('click', () => {
                updateCarousel(currentIndex + 1);
            });

            // make each member clickable, which moves the
            // view down to the carousel on the members section
            gridMembers.forEach((member, index) => {
                member.addEventListener('click', () => {
                    updateCarousel(index);
                    carouselContainer.scrollIntoView({
                        // ensures that the scroll down is smooth and centered
                        behavior:"smooth",
                        block:"center"
                    })
                })
            });
        });
    });

</script>
