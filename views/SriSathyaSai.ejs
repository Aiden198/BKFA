<%# Sri Sathya Sai supporter profile and related impact content. %>
<%- include('partials/header') %>

<main class="page-main-with-hero about-main">
    <section class="page-hero-top about-hero-top" aria-label="Sri Sathya Sai hero image">
        <img src="/images/2024/11/IMG-20241118-WA0020.jpg" alt="Sri Sathya Sai partnership with BKFA">
    </section>

    <div class="page-body-with-sidebar">
        <%- include('partials/ourSupportersSideMenu') %>

    <div class="page-content about-page-content supporters-page">
        <section class="supporters-hero">
            <h1 class="supporters-title">Sri Sathya Sai</h1>
        </section>

        <section class="supporters-image-section">
            <div class="supporters-image-banner supporters-image-banner--wide">
                <img
                    src="/images/2024/11/IMG-20241118-WA0020.jpg"
                    alt="Sri Sathya Sai partnership with BKFA"
                >
            </div>
        </section>

        <section class="supporters-content-section">
            <h2>Sri Sathya Sai and BKFA</h2>
            <p>
                BKFA is proud to work alongside the Sri Sathya Sai Global Council in Australia, with over 50 Clean Birth Kit
                Assembly Days held since 2012.
            </p>
        </section>

        <section class="supporters-image-section fly-in" data-fly="down">
            <div class="supporters-logo-block">
                <img
                    src="/images/2025/11/SSS-aust-logo.png"
                    alt="Sri Sathya Sai Australia logo"
                >
            </div>
        </section>

        <section class="supporters-content-section fly-in" data-fly="right">
            <p>
                The Sri Sathya Sai International Organization is a non-denominational, voluntary, spiritual organization
                with a strong emphasis on selfless service and unity of faiths, based in 120 countries.
            </p>
        </section>

        <section class="supporters-content-section fly-in" data-fly="left">
            <h2>Sai Centre Partnerships</h2>
            <p>
                Sri Sathya Sai in Australia has partnered with BKFA since 2012, assembling over 32,000 Clean Birth Kits
                at more than 50 Assembly Days. We acknowledge and are deeply grateful for the contribution of the Sai
                Centres involved, including:
            </p>

            <div class="supporters-club-list fly-in" data-fly="right">
                <p>Helensvale Sai Centre</p>
                <p>Sai Organisation of Australia</p>
                <p>SAI Youth Australia NSW</p>
                <p>Sathya Sai Centre of Mill Park</p>
                <p>Sathya Sai Gold Coast</p>
                <p>Sathya Sai International WA</p>
                <p>Sathya Sai Organisation ACT</p>
                <p>Sathya Sai Organisation QLD</p>
                <p>Sathya Sai Organisation SA</p>
                <p>Sathya Sai Organisation Strathfield</p>
                <p>Sri Sathya Sai Global Council Australia</p>
                <p>Sri Sathya Sai Organisation Aust and PNG ACT Region</p>
                <p>Sri Sathya Sai Organisation Aust and PNG NSW Region</p>
                <p>Sri Sathya Sai Organisation Aust and PNG VIC Region</p>
                <p>Tuggeranong Sri Sathya Sai Service Organisation</p>
            </div>
        </section>

        <section class="supporters-content-section fly-in" data-fly="left">

            <p>
                If your Centre would like to hold an Assembly Day in Australia, you can find more information
                <a href="/volunteer/hostanassemblyday" class="supporters-link">here</a>.
            </p>

            <p>
                If your Centre would like to hold a fundraising event, you can find more information
                <a href="/donate/fundraise" class="supporters-link">here</a>.
            </p>
        </section>

        <section class="supporters-image-section fly-in" data-fly="right">
            <div class="supporters-gallery-grid">
                <div class="supporters-gallery-item">
                    <img src="/images/2024/11/sri-sathya-sai-BKFA-0054.jpg" alt="Sri Sathya Sai Assembly Day photo 1">
                </div>
                <div class="supporters-gallery-item">
                    <img src="/images/2024/11/sri-sathya-sai-BKFA-0049.jpg" alt="Sri Sathya Sai Assembly Day photo 2">
                </div>
                <div class="supporters-gallery-item">
                    <img src="/images/2024/11/sri-sathya-sai-BKFA-0045.jpg" alt="Sri Sathya Sai Assembly Day photo 3">
                </div>
                <div class="supporters-gallery-item">
                    <img src="/images/2024/11/sri-sathya-sai-BKFA-0044.jpg" alt="Sri Sathya Sai Assembly Day photo 4">
                </div>
                <div class="supporters-gallery-item">
                    <img src="/images/2024/11/sri-sathya-sai-BKFA-0042.jpg" alt="Sri Sathya Sai Assembly Day photo 5">
                </div>
                <div class="supporters-gallery-item">
                    <img src="/images/2024/11/IMG-20241119-WA0046.jpg" alt="Sri Sathya Sai Assembly Day photo 6">
                </div>
            </div>
        </section>
