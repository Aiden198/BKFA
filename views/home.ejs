<% locals.showDonateBanner = true; %>
<%- include('partials/header') %>

<script src="/javascripts/countUp.umd.js"></script>
<script src="/javascripts/counter.js"></script>
<script src="/javascripts/home-hero-carousel.js" defer></script>
<script src="/javascripts/home-kit-carousel.js" defer></script>

<%
const kitItems = [
    {
        title: 'A Plastic Sheet',
        description: 'To prevent the mother and newborn coming into contact with the ground or an unhygienic surface.',
        graphic: '/images/2022/11/birthing-kit-icon-plastic-sheet.png',
        image: '/images/2022/11/birthing-kit-sheet.jpg'
    },
    {
        title: 'Soap',
        description: 'To wash the birth attendant’s hands and the mother’s perineum.',
        graphic: '/images/2022/11/birthing-kit-icon-soap.png',
        image: '/images/2022/11/birthing-kit-soap.jpg'
    },
    {
        title: 'Cord Ties',
        description: 'To tie the umbilical cord.',
        graphic: '/images/2022/11/birthing-kit-icon-cord.png',
        image: '/images/2022/11/birthing-kit-cord.jpg'
    },
    {
        title: 'Sterile Blade',
        description: 'To cut the umbilical cord cleanly and reduce risk of newborn sepsis and tetanus.',
        graphic: '/images/2022/11/birthing-kit-icon-blade.png',
        image: '/images/2022/11/birthing-kit-blade.jpg'
    },
    {
        title: 'Gloves',
        description: 'To cover the birth attendant’s hands and provide protection from infections such as HIV for carers and care recipients.',
        graphic: '/images/2022/11/birthing-kit-icon-gloves.png',
        image: '/images/2022/11/birthing-kit-gloves.jpg'
    }
];
%>

<script>
  const bar = document.querySelector('.donate-bar');
  const nav = document.querySelector('.navbar');
  if (bar && nav) {
    nav.style.top = bar.offsetHeight + 'px';
  }
</script>

<main class="home-page">
    <header class="hero hero--feature">
        <div class="container">
            <div class="hero-feature">
                <img class="hero-feature__slide is-active" src="/images/2026/03/Beneficiaries_-local-leaders-and-volunteers-pose-for-a-group-photo-after-distribution-of-kits-in-Kizungu-on-22-jan-2025-scaled.jpg" alt="Community members holding birthing kits after distribution.">
                <img class="hero-feature__slide" src="/images/2025/04/hut.jpg" alt="A rural home in a community setting.">
                <div class="hero-feature__overlay">
                    <h1>A world in which all women and girls have access to a clean and safe birth.</h1>
                </div>
            </div>
        </div>
    </header>

    <section class="section home-panel home-panel--twenty">
        <div class="home-panel__inner">
            <section class="find-out-more-section fly-in" data-fly="up">
                <div class="find-out-more-grid">
                    <div class="find-out-more-image">
                        <img src="/images/2025/04/mums-group.jpg" alt="20 Years of BKFA">
                    </div>

                    <div class="find-out-more-content">
                        <h2>CELEBRATE 20 YEARS OF THE BKFA</h2>
                        <p>
                            Help us pack 20,000 kits across the country during May to acknowledge our 20 year milestone!
                        </p>
                        <a href="/twenty-years" class="find-out-more-btn">FIND OUT MORE</a>
                    </div>
                </div>
            </section>
        </div>
    </section>

    <section class="section home-panel home-panel--about">
        <div class="home-panel__inner">
            <div class="home-about-block fly-in" data-fly="left">
                <h2>WHO WE ARE </h2>
                <p>The Birthing Kit Foundation (Australia) is a humanitarian organisation that provides birthing kits and
                    education in clean birthing practices to women birthing at home in remote regions of the developing world.</p>
            </div>

            <div class="home-about-layout">
                <div class="home-about-copy">
                    <div class="home-about-block fly-in" data-fly="right">
                        <h2>WHAT WE DO</h2>
                        <p>We work in partnership with the Australian Community and a number of Global Organisations to pack and
                            supply Clean Birth Kits to pregnant women living in rural communities and low-resource settings around the world. To date,
                            3 million Clean Birth Kits have been distributed to women in need. Kits are given to mothers through community outreach programs,
                            supplied to health facilities for use by doctors, midwives and nurses or distributed to traditional birthing attendants.
                            They are designed to support hygienic practices and environments during childbirth in under-resourced settings.</p>
                    </div>
                    <div class="home-about-block fly-in" data-fly="left">
                        <h2>OUR ACHIEVEMENTS</h2>
                        <p>We have supplied over 3 million clean birth kits to women in remote regions of over 30 countries, trained
                            over 10,000 traditional birth attendants and contributed to the prevention of FGM in communities that were killing their women in childbirth.
                            The impact of our work can not be underestimated, with many unexpected benefits for the women and communities we support. You can find out more here.</p>
                        <h2>OUR VISION</h2>
                        <p>A world in which all women and girls have access to a clean and safe birth.</p>
                        <h2>OUR MISSION</h2>
                        <p>To positively impact the lives of mothers and babies in developing countries.</p>
                        <p>To partner with and empower our partner organisations and communities.</p>
                        <p>To enable systems where women and girls become truly empowered.</p>
                    </div>

                </div>
                <figure class="home-about-image fly-in" data-fly="right">
                    <img src="/images/2022/11/BKF-pregnant-smiling.jpg" alt="A smiling pregnant woman standing outside.">
                </figure>
            </div>

            <div class="cards-grid repeat-four mission-cta-grid fly-in" data-fly="up">
                <a href="/donate" class="cta-band">
                    <h3>DONATE NOW</h3>
                </a>

                <a href="/volunteer" class="cta-band">
                    <h3>PACK KITS</h3>
                </a>

                <a href="/resources" class="cta-band">
                    <h3>ASSEMBLY DAY MANUAL</h3>
                </a>

                <a href="/OurProjects/FieldPartners" class="cta-band">
                    <h3>BECOME A FIELD PARTNER</h3>
                </a>
            </div>
        </div>
    </section>

    <section class="video-section home-panel home-panel--video">
        <div class="home-panel__inner">
            <div class="video-wrapper">
                <iframe
                    src="https://www.youtube.com/embed/PBk6cvC49SI"
                    title="BKFA Video"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen>
                </iframe>
            </div>
        </div>
    </section>

    <section class="distribution-section">
        <div class="distribution-section__inner container">
            <div class="distribution-layout">
                <div class="distribution-card fly-in" data-fly="up">
                    <div class="distribution-card__top">
                        <div class="distribution-card__icon">
                            <img src="/images/2022/10/icon-Birthing-kit.png" alt="Birthing kit icon">
                        </div>
                        <div class="distribution-card__value">
                            <h3 id="count-total-kits">3 M</h3>
                        </div>
                    </div>
                    <p class="distribution-card__copy">ACCUMULATIVE TOTAL NUMBER OF KITS DISTRIBUTED</p>
                </div>

                <div class="distribution-copy fly-in" data-fly="right">
                    <h2>Birthing Kit Distribution</h2>
                    <p>
                        To date, 3 million Clean Birth Kits have been distributed to women in need. Kits are given to mothers through
                        community outreach programs, supplied to health facilities for use by doctors, midwives and nurses or distributed
                        to traditional birthing attendants. They are designed to support hygienic practices and environments during childbirth
                        in under-resourced settings.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="section home-panel home-panel--glance">
        <div class="home-panel__inner">
            <div class="section__header">
                <h2>2024/25 AT A GLANCE</h2>
                <div class="cards-grid cards-grid--glance">
                    <div class="glance-card fly-in" data-fly="up">
                        <div class="glance-card__top">
                            <div class="glance-card__icon">
                                <img src="/images/2022/10/icon-assembly-days.png" alt="Assembly days icon">
                            </div>
                            <div class="glance-card__value">
                                <h3 id="count-assembly">303</h3>
                            </div>
                        </div>
                        <p class="glance-card__copy">ASSEMBLY DAYS WERE HELD IN AUSTRALIA</p>
                    </div>
                    <div class="glance-card fly-in" data-fly="down">
                        <div class="glance-card__top">
                            <div class="glance-card__icon">
                                <img src="/images/2022/10/icon-volunteers.png" alt="Volunteers icon">
                            </div>
                            <div class="glance-card__value">
                                <h3 id="count-volunteers">15k</h3>
                            </div>
                        </div>
                        <p class="glance-card__copy">VOLUNTEERS DEDICATED THEIR TIME TO ASSEMBLE BIRTHING KITS</p>
                    </div>
                    <div class="glance-card fly-in" data-fly="up">
                        <div class="glance-card__top">
                            <div class="glance-card__icon">
                                <img src="/images/2022/10/icon-maternity.png" alt="Maternity icon">
                            </div>
                            <div class="glance-card__value">
                                <h3 id="count-mothers">258k</h3>
                            </div>
                        </div>
                        <p class="glance-card__copy">MOTHERS AND NEWBORNS WERE HELPED WITH HEALTH EQUIPMENT AND/OR SERVICES</p>
                    </div>
                    <div class="glance-card fly-in" data-fly="down">
                        <div class="glance-card__top">
                            <div class="glance-card__icon">
                                <img src="/images/2022/10/icon-Birthing-kit.png" alt="Birthing kits icon">
                            </div>
                            <div class="glance-card__value">
                                <h3 id="count-kits-sent">129k</h3>
                            </div>
                        </div>
                        <p class="glance-card__copy">BIRTHING KITS WERE SENT TO PEOPLE IN UNDER-RESOURCED AND HUMANITARIAN SETTINGS</p>
                    </div>
                    <div class="glance-card fly-in" data-fly="up">
                        <div class="glance-card__top">
                            <div class="glance-card__icon">
                                <img src="/images/2022/10/icon-global-partners.png" alt="Global partners icon">
                            </div>
                            <div class="glance-card__value">
                                <h3 id="count-global-partners">27</h3>
                            </div>
                        </div>
                        <p class="glance-card__copy">GLOBAL PARTNERS ACROSS 11 COUNTRIES WERE INVOLVED IN OUR GLOBAL INITIATIVES</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="kit-carousel-section home-panel home-panel--kit">
        <div class="home-panel__inner">
            <div class="kit-carousel-header fly-in" data-fly="up">
                <div class="kit-carousel-header__lead">
                    <div class="kit-carousel-header__title-row">
                        <h2>The Birthing Kit</h2>
                        <span class="kit-carousel-header__logo">
                            <img src="/images/2022/10/icon-Birthing-kit.png" alt="Birthing kit logo">
                        </span>
                    </div>
                </div>
                <p>Click the arrows below to view all items in the kit. Hover over each card to reveal the real item.</p>
            </div>

            <div class="kit-carousel-shell fly-in" data-fly="up" data-kit-carousel>
                <div class="kit-carousel-track" data-kit-track>
                    <% kitItems.forEach(function(item) { %>
                        <article class="kit-item-card">
                            <div class="kit-item-card__graphic" style="background-image: url('<%= item.graphic %>');" aria-hidden="true"></div>
                            <div class="kit-item-card__photo" style="background-image: url('<%= item.image %>');"></div>
                            <div class="kit-item-card__veil"></div>
                            <div class="kit-item-card__content">
                                <div class="kit-item-card__copy">
                                    <h3><%= item.title %></h3>
                                    <p><%= item.description %></p>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </div>

                <div class="kit-carousel-controls">
                    <button type="button" class="kit-carousel-control" data-kit-prev aria-label="Show previous kit item">
                        <i class="fa-solid fa-arrow-left"></i>
                    </button>
                    <button type="button" class="kit-carousel-control" data-kit-next aria-label="Show next kit item">
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
