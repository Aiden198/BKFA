<%# Supporter overview, featured organisations, and community acknowledgements. %>
<link rel="stylesheet" href="/stylesheets/oursupporters.css">

<%- include('partials/header') %>

<main id="supporters-page" class="page-main-with-hero about-main">
    <section class="page-hero-top about-hero-top" aria-label="Our supporters hero image">
        <img src="/images/2022/10/KalvarayanHills2-EDITED.jpg" alt="A woman hugging a child">
    </section>

    <div class="page-body-with-sidebar">
        <%- include('partials/aboutUsSideMenu') %>

        <div class="page-content about-page-content about-supporters-page">
            <section class="about-text-section">
                <h1>OUR SUPPORTERS</h1>
                <p>We would like to acknowledge the valuable contributions of our supporters, who provide financial and in-kind support.</p>
            </section>

            <div class="supporters-grid">
                <a href="/oursupporters/zontaclub" class="supporter-logo">
                    <img src="/images/2022/11/Zonta-logo.jpg" alt="Zonta Club">
                </a>
                <a href="/oursupporters/srisathyasai" class="supporter-logo">
                    <img src="/images/2025/11/SSS-aust-logo.png" alt="Sri Sathya Sai">
                </a>
                <a href="https://munglobal.com.au/" target="_blank" rel="noopener noreferrer" class="supporter-logo">
                    <img src="/images/2022/11/mun-foundation.jpg" alt="Mun Global">
                </a>
            </div>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
