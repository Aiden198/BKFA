<link rel="stylesheet" href="/stylesheets/becomeamember.css">

<%- include('partials/header') %>

<main>
    <div id="members-page">

        <div class="main-container--sidebar">
            <%- include('partials/getInvolvedSideMenu') %>

            <div class="page-content">
                <h1>Become a Member</h1>

                <p>
                    For just $30 for an individual and $70 for a corporate membership, becoming a BKFA member is a great way to show your support.
                    Anyone over the age of 18 is eligible and membership lasts for one year. BKFA Members will receive the newsletter and Annual Report,
                    plus general updates and occasional appeals. Members are also invited to attend and vote at the AGM. If you do not wish to receive
                    this information please confirm this by email to info@bkfa.org.au.
                </p>

                <p>
                    If you would like to become a member, download the Membership Application Form and email it to info@bkfa.org.au or
                    simply complete the form below. Membership runs from the time you join until June 30th.
                </p>
            </div>
        </div>

        <div class="map-form-section">

            <div class="map-form-card">

                <h2>BECOME A MEMBER</h2>

                <form
                    method="POST"
                    action="/becomeamember"
                    class="membership-form"
                >

                    <div class="form-grid">

                        <!-- MEMBER STATUS -->
                        <div class="form-group form-group--full">

                            <label class="form-label">
                                Are you a new or renewing member?
                            </label>

                            <div class="radio-group">

                                <label class="radio-label">
                                    <input
                                        type="radio"
                                        name="memberStatus"
                                        value="new"
                                        required
                                    >

                                    <span>New Member</span>
                                </label>

                                <label class="radio-label">
                                    <input
                                        type="radio"
                                        name="memberStatus"
                                        value="renewing"
                                    >

                                    <span>Renewing Member</span>
                                </label>

                            </div>

                        </div>

                        <!-- HEAR ABOUT US -->
                        <div class="form-group form-group--half">

                            <label for="hearAboutUs">
                                How did you hear about us?
                            </label>

                            <select
                                id="hearAboutUs"
                                name="hearAboutUs"
                            >

                                <option value="" disabled selected>
                                    Select an option
                                </option>

                                <option value="friend">
                                    Friend referral
                                </option>

                                <option value="social">
                                    Social media
                                </option>

                                <option value="event">
                                    Industry event / conference
                                </option>

                                <option value="volunteer">
                                    Volunteer event
                                </option>

                                <option value="website">
                                    BKFA website
                                </option>

                                <option value="other">
                                    Other
                                </option>

                            </select>

                        </div>

                        <div class="form-group form-group--half"></div>

                        <!-- MEMBER TYPE -->
                        <div class="form-group form-group--full">

                            <label class="form-label">
                                I would like to register as an...
                            </label>

                            <div class="radio-group">

                                <label class="radio-label">
                                    <input
                                        type="radio"
                                        name="memberType"
                                        value="individual"
                                        required
                                    >

                                    <span>Individual Member</span>
                                </label>

                                <label class="radio-label">
                                    <input
                                        type="radio"
                                        name="memberType"
                                        value="corporate"
                                    >

                                    <span>Corporate Member</span>
                                </label>

                            </div>

                        </div>

                        <!-- OPTIONS -->
                        <div class="form-group form-group--full">

                            <label class="form-label">
                                Options
                            </label>

                            <div class="form-checkboxes">

                                <label class="checkbox-label">

                                    <input
                                        type="checkbox"
                                        id="taxDeductibleDonation"
                                        name="taxDeductibleDonation"
                                        onchange="toggleDonationAmount(this)"
                                    >

                                    <span>
                                        I would like to make a tax deductible donation in addition to my membership
                                    </span>

                                </label>

                                <div
                                    id="donationAmountGroup"
                                    class="donation-amount-group"
                                >

                                    <label for="donationAmount">
                                        Donation Amount ($)
                                    </label>

                                    <input
                                        type="number"
                                        id="donationAmount"
                                        name="donationAmount"
                                        placeholder="Enter donation amount"
                                        min="1"
                                    >

                                </div>

                                <label class="checkbox-label">

                                    <input
                                        type="checkbox"
                                        id="annualReportHardCopy"
                                        name="annualReportHardCopy"
                                    >

                                    <span>
                                        I would like a hard copy of the Annual Report
                                    </span>

                                </label>

                            </div>

                        </div>

                        <!-- FIRST NAME -->
                        <div class="form-group form-group--full">

                            <label for="firstName">
                                First Name
                            </label>

                            <input
                                type="text"
                                id="firstName"
                                name="firstName"
                                placeholder="Enter your first name"
                                required
                            >

                        </div>

                        <!-- LAST NAME -->
                        <div class="form-group form-group--full">

                            <label for="lastName">
                                Last Name
                            </label>

                            <input
                                type="text"
                                id="lastName"
                                name="lastName"
                                placeholder="Enter your last name"
                                required
                            >

                        </div>

                        <!-- COMPANY -->
                        <div class="form-group form-group--full">

                            <label for="companyClub">
                                Company/Club (if applicable)
                            </label>

                            <input
                                type="text"
                                id="companyClub"
                                name="companyClub"
                                placeholder="Enter your company/club"
                            >

                        </div>

                        <div class="form-divider form-group--full">
                            <span>Address Details</span>
                        </div>

                        <!-- STREET -->
                        <div class="form-group form-group--full">

                            <label for="streetAddress">
                                Street Address
                            </label>

                            <input
                                type="text"
                                id="streetAddress"
                                name="streetAddress"
                                placeholder="Enter your street address"
                            >

                        </div>

                        <!-- CITY -->
                        <div class="form-group form-group--half">

                            <label for="city">
                                City
                            </label>

                            <input
                                type="text"
                                id="city"
                                name="city"
                                placeholder="Enter your city here"
                            >

                        </div>

                        <!-- STATE -->
                        <div class="form-group form-group--half">

                            <label for="state">
                                State / Province / Region
                            </label>

                            <input
                                type="text"
                                id="state"
                                name="state"
                                placeholder="Enter your state / province / region here"
                            >

                        </div>

                        <!-- ZIP -->
                        <div class="form-group form-group--half">

                            <label for="zipPostal">
                                ZIP / Postal Code
                            </label>

                            <input
                                type="text"
                                id="zipPostal"
                                name="zipPostal"
                                placeholder="Enter your ZIP / Postal Code here"
                            >

                        </div>

                        <div class="form-group form-group--half"></div>

                        <div class="form-divider form-group--full">
                            <span>Contact Information</span>
                        </div>

                        <!-- MOBILE -->
                        <div class="form-group form-group--full">

                            <label for="mobile">
                                Mobile
                            </label>

                            <input
                                type="tel"
                                id="mobile"
                                name="mobile"
                                placeholder="Enter your mobile number"
                            >

                        </div>

                        <!-- HOME NUMBER -->
                        <div class="form-group form-group--full">

                            <label for="homeNumber">
                                Home/Business Phone Number
                            </label>

                            <input
                                type="tel"
                                id="homeNumber"
                                name="homeNumber"
                                placeholder="Enter your home number"
                            >

                        </div>

                        <!-- EMAIL -->
                        <div class="form-group form-group--full">

                            <label for="email">
                                Email
                            </label>

                            <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="Enter your email here"
                                required
                            >

                        </div>

                        <!-- AGREEMENTS -->
                        <div class="form-group form-group--full">

                            <label class="form-label">
                                In applying for membership of the Birthing Kit Foundation Australia, you certify that:
                            </label>

                            <div class="form-checkboxes">

                                <label class="checkbox-label">

                                    <input
                                        type="checkbox"
                                        id="over18"
                                        name="over18"
                                        required
                                    >

                                    <span>
                                        You are over 18 years and agree to be bound by the BKFA Constitution.
                                    </span>

                                </label>

                                <label class="checkbox-label">

                                    <input
                                        type="checkbox"
                                        id="agreeToPay"
                                        name="agreeToPay"
                                        required
                                    >

                                    <span>
                                        You agree to pay the appropriate membership fee.
                                    </span>

                                </label>

                                <label class="checkbox-label">

                                    <input
                                        type="checkbox"
                                        id="upholdValues"
                                        name="upholdValues"
                                        required
                                    >

                                    <span>
                                        You agree to uphold and support the values and mission of BKFA.
                                    </span>

                                </label>

                                <label class="checkbox-label">

                                    <input
                                        type="checkbox"
                                        id="avoidConflictofInterest"
                                        name="avoidConflictofInterest"
                                        required
                                    >

                                    <span>
                                        You will avoid and declare any actual, potential or perceived conflict of interest.
                                    </span>

                                </label>

                                <label class="checkbox-label">

                                    <input
                                        type="checkbox"
                                        id="noCompromise"
                                        name="noCompromise"
                                        required
                                    >

                                    <span>
                                        You have not been reported or convicted regarding any action which may have brought a charity into disrepute.
                                    </span>

                                </label>

                                <label class="checkbox-label">

                                    <input
                                        type="checkbox"
                                        id="noRevoke"
                                        name="noRevoke"
                                        required
                                    >

                                    <span>
                                        You have not had membership revoked from any organisation.
                                    </span>

                                </label>

                                <label class="checkbox-label">

                                    <input
                                        type="checkbox"
                                        id="privacyPolicy"
                                        name="privacyPolicy"
                                        required
                                    >

                                    <span>
                                        You agree to the terms of our Privacy Policy.
                                    </span>

                                </label>

                                <label class="checkbox-label">

                                    <input
                                        type="checkbox"
                                        id="updatesAndNewsletter"
                                        name="updatesAndNewsletter"
                                    >

                                    <span>
                                        You agree to receive the BKFA newsletter and updates.
                                    </span>

                                </label>

                            </div>

                        </div>

                    </div>

                    <div class="form-group form-group--full">

                        <p style="
                            background: #f4f4f4;
                            padding: 1rem;
                            border-left: 4px solid #555583;
                            border-radius: 8px;
                            line-height: 1.6;
                        ">
                            Payment is not processed through this form.
                            Once your order request has been reviewed,
                            BKFA will contact you regarding payment and shipping arrangements.
                        </p> <!-- THIS IS A PLACEHOLDER FOR PAYMENT INFO, TO BE REPLACED WITH ACTUAL PAYMENT INTEGRATION IN THE FUTURE -->

                    </div>


                    <div class="captcha-wrapper">
                        <div
                        class="g-recaptcha"
                        data-sitekey="<%= process.env.RECAPTCHA_SITE_KEY %>">
                        </div>
                    </div>

                    <button
                        class="form-submit-btn"
                        type="submit"
                    >
                        Submit Application
                    </button>

                </form>

            </div>

        </div>

    </div>
</main>

<script src="https://www.google.com/recaptcha/api.js" async defer></script>

<script>
    function toggleDonationAmount(checkbox) {

        const donationGroup =
            document.getElementById(
                'donationAmountGroup'
            );

        if (checkbox.checked) {

            donationGroup.classList.add(
                'visible'
            );

        } else {

            donationGroup.classList.remove(
                'visible'
            );

            document.getElementById(
                'donationAmount'
            ).value = '';

        }
    }

    const membershipForm =
        document.querySelector('.membership-form');

    membershipForm.addEventListener(
        'submit',
        function (e) {

            const captchaResponse =
                grecaptcha.getResponse();

            if (!captchaResponse) {

                e.preventDefault();

                alert(
                    'Please complete the CAPTCHA before submitting the form.'
                );
            }
        }
    );

</script>

<%- include('partials/footer') %>