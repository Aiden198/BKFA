# Normalize text files in the repository and keep common web/code files on LF
* text=auto

*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.ejs text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
